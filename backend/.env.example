# App
APP_PORT=3001
APP_ENV=development
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://hosting_nepal:password@localhost:5432/hosting_nepal

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (Cloud Console → APIs & Services → Credentials → OAuth client ID)
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4001/api/v1/auth/google/callback

# ResellerClub API
RESELLERCLUB_AUTH_USERID=
RESELLERCLUB_API_KEY=
RESELLERCLUB_BASE_URL=https://httpapi.com/api
RESELLERCLUB_SANDBOX_URL=https://test.httpapi.com/api
RESELLERCLUB_USE_SANDBOX=true

# Payment Gateways
KHALTI_SECRET_KEY=
KHALTI_PUBLIC_KEY=
KHALTI_BASE_URL=https://khalti.com/api/v2
ESEWA_MERCHANT_CODE=
ESEWA_BASE_URL=https://epay.esewa.com.np/api/epay/main/v2

# Email — Nepal Fillings transactional API (https://nepalfillings.com/api/v1/email)
NF_EMAIL_API_URL=https://nepalfillings.com/api/v1
NF_EMAIL_API_KEY=nf_email_<your-key>
MAIL_FROM_EMAIL=noreply@hostingnepals.com
MAIL_FROM_NAME=Hosting Nepal
MAIL_REPLY_TO=support@hostingnepals.com

# Legacy SendGrid (deprecated — leave blank)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@hostingnepal.com

# SMS
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=HostingNepal

# Encryption
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# Blog Auto-Generation (Gemini free tier)
GEMINI_API_KEY=
UNSPLASH_ACCESS_KEY=
BLOG_AUTOGEN_ENABLED=false
BLOG_AUTOGEN_MODEL=gemini-2.5-flash
BLOG_AUTOGEN_BOT_EMAIL=content-bot@hostingnepals.com

# Error tracking — self-hosted GlitchTip (Sentry-API compatible).
# Leave SENTRY_DSN blank locally to disable. In prod, paste the DSN from the
# GlitchTip "hn-backend" project. See glitchtip/docker-compose.yml.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# GlitchTip API — powers the in-app SUPER_ADMIN "Error Tracking" dashboard
# (/dashboard/error-tracking). The backend proxies GlitchTip so this token never
# reaches the browser. Token: GlitchTip UI → Profile → Auth Tokens (read scope).
GLITCHTIP_API_URL=https://errors.hostingnepals.com
GLITCHTIP_API_TOKEN=
GLITCHTIP_ORG_SLUG=
# Optional: public UI URL for "Open in GlitchTip" links (defaults to GLITCHTIP_API_URL)
GLITCHTIP_URL=https://errors.hostingnepals.com

# Image storage — local VPS disk (Cloudflare caches at the edge)
# UPLOAD_DIR is the on-container path; map it to a host volume in docker-compose.
# UPLOAD_PUBLIC_BASE_URL is the URL prefix at which /uploads/* is served publicly.
UPLOAD_DIR=/var/uploads
UPLOAD_PUBLIC_BASE_URL=https://api.hostingnepals.com/uploads

# Image storage — Cloudflare R2 (preferred). When R2_ACCOUNT_ID + the keys +
# bucket + public base are all set, StorageService uploads to R2 and serves via
# R2_PUBLIC_BASE_URL instead of local disk. Leave blank to use /var/uploads.
# Secrets live in .env.production. (R2_ACCOUNT_ENDPOINT may be set instead of
# R2_ACCOUNT_ID to override the full S3 endpoint.)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hostingnepals-images-rw
R2_PUBLIC_BASE_URL=https://cdn.hostingnepals.com
