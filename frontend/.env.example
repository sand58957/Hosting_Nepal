# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
BASEPATH=

# -----------------------------------------------------------------------------
# Error tracking — self-hosted GlitchTip (Sentry-API compatible)
# -----------------------------------------------------------------------------
# DSN from the GlitchTip "hn-frontend" project. Public by design (ships in the
# browser bundle). Leave blank to disable. Must be set at BUILD time — see the
# NEXT_PUBLIC_SENTRY_DSN build arg in the Dockerfile / root docker-compose.yml.
NEXT_PUBLIC_SENTRY_DSN=
# GlitchTip dashboard URL — target of the SUPER_ADMIN-only "Error Tracking" nav link.
NEXT_PUBLIC_GLITCHTIP_URL=https://errors.hostingnepals.com
